# supabase (public visitor tracker + suggestion box + whoop token store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only. used to persist the rotating whoop refresh token. find this
# under supabase project settings → api → service_role key. never expose.
SUPABASE_SERVICE_ROLE_KEY=

# cloudflare r2 (photo storage, dev-only mutation paths)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=

# whoop — personal health dashboard
# register an app at https://developer.whoop.com
# WHOOP_REFRESH_TOKEN is produced by `bun run scripts/whoop-auth.ts`
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=
WHOOP_OAUTH_REDIRECT_URI=http://localhost:3000/whoop-callback

# openrouter — small model for varied dashboard copy and biomarker pdf parsing
# get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# biomarkers — single shared password gate for /health/biomarkers
# COOKIE_SECRET is a random 32-byte hex string used to hmac-sign the session
# cookie. rotate it to force a hard logout for every existing session.
#   bun -e "console.log(crypto.getRandomValues(new Uint8Array(32)).reduce((a,b)=>a+b.toString(16).padStart(2,'0'),''))"
SITE_PASSWORD=
COOKIE_SECRET=

# anthropic — lab pdf parsing for biomarker uploads. uses a stronger model
# than the openrouter copy/health pipeline since the json schema is strict.
ANTHROPIC_API_KEY=
ANTHROPIC_BIOMARKER_MODEL=claude-sonnet-4-6
